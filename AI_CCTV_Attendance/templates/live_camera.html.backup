{% extends 'layout.html' %}

{% block content %}
<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="fw-bold mb-1">Live CCTV Recognition</h2>
                <p class="text-muted mb-0">Camera: {{ camera_id }}</p>
            </div>
            <button id="start-camera" class="btn btn-primary">Start Camera</button>
        </div>

        <div class="video-frame border rounded overflow-hidden mb-3" style="max-width: 720px;">
            <video id="live-video" autoplay playsinline muted style="width: 100%; height: auto; background: #111; min-height: 320px;"></video>
        </div>

        <div class="d-flex gap-2 mb-3">
            <button id="capture-image" class="btn btn-success" type="button">Capture and Recognize</button>
            <button id="stop-camera" class="btn btn-outline-secondary" type="button">Stop Camera</button>
        </div>

        <div id="camera-status" class="alert alert-info mb-0" role="alert">
            Camera is idle. Click “Start Camera” to begin.
        </div>
        <div id="recognition-result" class="mt-3"></div>
    </div>
</div>

<script>
const video = document.getElementById('live-video');
const statusBox = document.getElementById('camera-status');
const resultBox = document.getElementById('recognition-result');
const startButton = document.getElementById('start-camera');
const stopButton = document.getElementById('stop-camera');
const captureButton = document.getElementById('capture-image');

let stream = null;

async function startCamera() {
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        statusBox.className = 'alert alert-danger';
        statusBox.textContent = 'This browser does not support webcam access.';
        return;
    }

    try {
        stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
        video.srcObject = stream;
        video.play();
        statusBox.className = 'alert alert-success';
        statusBox.textContent = 'Camera is live. Position your face in the frame and click Capture and Recognize.';
    } catch (error) {
        statusBox.className = 'alert alert-danger';
        statusBox.textContent = 'Unable to access the camera. Please allow webcam permissions and try again.';
        console.error(error);
    }
}

function stopCamera() {
    if (stream) {
        stream.getTracks().forEach(track => track.stop());
        stream = null;
    }
    if (video.srcObject) {
        video.srcObject.getTracks().forEach(track => track.stop());
        video.srcObject = null;
    }
    statusBox.className = 'alert alert-secondary';
    statusBox.textContent = 'Camera stopped.';
}

async function captureAndRecognize() {
    if (!video.videoWidth || !video.videoHeight) {
        statusBox.className = 'alert alert-warning';
        statusBox.textContent = 'Start the camera before capturing an image.';
        return;
    }

    const canvas = document.createElement('canvas');
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    const context = canvas.getContext('2d');
    context.drawImage(video, 0, 0, canvas.width, canvas.height);

    const imageData = canvas.toDataURL('image/jpeg', 0.9);
    statusBox.className = 'alert alert-info';
    statusBox.textContent = 'Recognizing face...';
    resultBox.innerHTML = '';

    try {
        const response = await fetch('{{ url_for("live_camera_recognize") }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ image: imageData })
        });
<<<<<<< HEAD
        const data = await readJsonResponse(response);
=======
        const data = await response.json();
>>>>>>> c625e4c (Update project)

        if (data.recognized) {
            resultBox.innerHTML = '<div class="alert alert-success">' +
                '<strong>' + data.name + '</strong> recognized successfully.<br>' +
                'Register No: ' + data.register_number + '<br>' +
                'Department: ' + data.department + '<br>' +
                'Status: ' + data.attendance_status + '<br>' +
                'Confidence: ' + data.confidence + '%</div>';
            statusBox.className = 'alert alert-success';
            statusBox.textContent = data.message || 'Attendance processed.';
        } else {
            resultBox.innerHTML = '<div class="alert alert-warning">' + (data.message || 'Unable to recognize this face.') + '</div>';
            statusBox.className = 'alert alert-warning';
            statusBox.textContent = data.message || 'Recognition attempt failed.';
        }
    } catch (error) {
        console.error(error);
        statusBox.className = 'alert alert-danger';
        statusBox.textContent = 'Recognition request failed. Please try again.';
    }
}

startButton.addEventListener('click', startCamera);
stopButton.addEventListener('click', stopCamera);
captureButton.addEventListener('click', captureAndRecognize);
</script>
{% endblock %}
